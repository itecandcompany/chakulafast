# ---------------------------------------------------------------------------
# Supabase — copy this file to `.env` and fill in your own project's values.
# Find them under Project Settings > API in the Supabase dashboard.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Same two values again, VITE_-prefixed so Vite inlines them into the browser
# bundle. The anon/publishable key is safe to expose — RLS is what protects
# the data. The service role key below is NOT.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-side admin client. Bypasses RLS — used by server functions for
# privileged reads/writes (payment confirmation, restaurant approval, the
# public dish search). NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Platform settings
# ---------------------------------------------------------------------------
# One-time restaurant registration fee, in TZS. Changing this only affects
# newly created payment records; existing ones keep the amount they were
# created with.
VITE_REGISTRATION_FEE_TZS=5000

# Which payment provider handles the registration fee.
#   manual       — admin marks payments as received in the admin console (default)
#   mobile_money — placeholder for M-Pesa / Tigo Pesa / Airtel Money; see
#                  src/lib/payments/mobileMoney.ts (not implemented yet)
PAYMENT_PROVIDER=manual

# Till/paybill number shown to restaurants on the billing page while
# PAYMENT_PROVIDER=manual.
VITE_PAYMENT_TILL_NUMBER=

# Set to "true" to show "Continue with Google" on the auth page. Requires
# Google OAuth to be enabled in your Supabase project dashboard.
VITE_ENABLE_GOOGLE_AUTH=false
